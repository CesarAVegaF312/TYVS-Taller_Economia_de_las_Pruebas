<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>edu.unisabana.tyvs</groupId>
  <artifactId>registraduria</artifactId>
  <version>1.0-SNAPSHOT</version>

  <name>registraduria</name>
  <description>Taller de Economia de las Pruebas - Testing y Validacion de Software</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <pitest.version>1.16.1</pitest.version>
    <pitest.junit5.version>1.2.1</pitest.junit5.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>

      <!-- JaCoCo: el lado del VALOR... o eso parece.
           Este taller lo usa para demostrar que la cobertura no mide valor:
           las patologias suben la cobertura y no aportan nada. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- El analizador de coste se ejecuta al final de `verify`, cuando los
           informes de Surefire ya estan escritos. Antes de esa fase no
           existen todavia: por eso no puede ser una prueba mas. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>informe-de-coste</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>edu.unisabana.tyvs.suite.AnalizadorDeSuite</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- PIT: el lado del VALOR de verdad.
           JaCoCo responde "que lineas se ejecutaron". PIT responde "si el
           codigo cambia, se entera alguna prueba?". Es la unica de las dos
           que no se puede falsificar con una prueba sin aserciones, y por eso
           es la metrica central de este taller.

           Sin mutationThreshold a proposito: aqui el numero se compara entre
           dos perfiles, no contra un minimo. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>edu.unisabana.tyvs.domain.*</param>
          </targetClasses>
          <targetTests>
            <param>edu.unisabana.tyvs.*</param>
          </targetTests>
          <outputFormats>
            <param>HTML</param>
            <param>XML</param>
          </outputFormats>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ====================================================================
         EL EXPERIMENTO CENTRAL DEL TALLER.

         Se mide el mutation score dos veces sobre el MISMO codigo de
         produccion:

           mvn test-compile org.pitest:pitest-maven:mutationCoverage
              -> con las 13 pruebas (suite buena + patologias)

           mvn -Psolo-buenas test-compile org.pitest:pitest-maven:mutationCoverage
              -> solo con las 7 pruebas de RegistryTest

         Si el numero no cambia, las seis patologias no aportan NADA al valor
         de la suite, y sin embargo se llevan la mayor parte del tiempo de
         ejecucion. Ese es el resultado que hay que ver con los propios ojos.
         ==================================================================== -->
    <profile>
      <id>solo-buenas</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <configuration>
              <targetTests>
                <param>edu.unisabana.tyvs.domain.service.RegistryTest</param>
              </targetTests>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
